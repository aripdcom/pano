<interface>
  <template class="TerminalPreferencesWindow" parent="AdwPreferencesWindow">
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="GtkShortcutController">
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;control&gt;w</property>
            <property name="action">action(window.close)</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkGestureClick" id="right_click_gesture">
        <signal name="pressed" handler="terminal_preferences_window_click_pressed_cb" />
        <property name="button">3</property>
        <property name="propagation-phase">capture</property>
      </object>
    </child>
    <menu id="context_menu_model">
      <section>
	<item>
          <attribute name="label" translatable="yes">_Reset to default</attribute>
          <attribute name="action">preferences.reset</attribute>
	  <attribute name="accel"></attribute>
	</item>
      </section>
    </menu>
    <property name="default-height">700</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Preferences</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Appearance</property>
            <child>
              <object class="AdwComboRow" id="theme_variant">
                <property name="title" translatable="yes">Theme Variant</property>
                <property name="expression">
                  <lookup name="title" type="TerminalPreferencesListItem"/>
                </property>
                <property name="model">
                  <object class="GListStore" id="theme_variants">
                    <property name="item-type">TerminalPreferencesListItem</property>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Default</property>
                        <property name="value">'system'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Dark</property>
                        <property name="value">'dark'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Light</property>
                        <property name="value">'light'</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="rounded_corners">
                <property name="title" translatable="yes">Rounded corners</property>
                <property name="expression">
                  <lookup name="title" type="TerminalPreferencesListItem"/>
                </property>
                <property name="model">
                  <object class="GListStore" id="rounded_corners_model">
                    <property name="item-type">TerminalPreferencesListItem</property>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Default</property>
                        <property name="value">'all'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Top only</property>
                        <property name="value">'top'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">None</property>
                        <property name="value">'none'</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="terminal_padding">
                <property name="title" translatable="yes">Space Around the Text</property>
                <property name="expression">
                  <lookup name="title" type="TerminalPreferencesListItem"/>
                </property>
                <property name="model">
                  <object class="GListStore" id="terminal_paddings">
                    <property name="item-type">TerminalPreferencesListItem</property>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes" context="terminal-padding">None</property>
                        <property name="value">'none'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes" context="terminal-padding">Small</property>
                        <property name="value">'small'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes" context="terminal-padding">Large</property>
                        <property name="value">'large'</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="header_bar_colors">
                <property name="title" translatable="yes">Color the Header Bar Like the Terminal</property>
                <property name="subtitle" translatable="yes">When the terminal uses a color scheme or colors of its own</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="dim_inactive_panes">
                <property name="title" translatable="yes">Dim Inactive Panes</property>
                <property name="subtitle" translatable="yes">In a split tab, fade the panes other than the one you type in</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="show_pane_titles">
                <property name="title" translatable="yes">Show Pane Titles</property>
                <property name="subtitle" translatable="yes">In a split tab, show the title of each pane above it</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="highlight_root_and_remote">
                <property name="title" translatable="yes">Highlight Root and Remote Sessions</property>
                <property name="subtitle" translatable="yes">Color the header bar and mark the tab while a terminal runs as root or over SSH</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="tab_bar_position">
                <property name="title" translatable="yes">Tab Bar Position</property>
                <property name="expression">
                  <lookup name="title" type="TerminalPreferencesListItem"/>
                </property>
                <property name="model">
                  <object class="GListStore" id="tab_bar_positions">
                    <property name="item-type">TerminalPreferencesListItem</property>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Top</property>
                        <property name="value">'top'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Bottom</property>
                        <property name="value">'bottom'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Left</property>
                        <property name="value">'left'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Right</property>
                        <property name="value">'right'</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Behavior</property>
            <child>
              <object class="AdwComboRow" id="new_terminal_mode">
                <property name="title" translatable="yes">Open New Terminals</property>
                <property name="expression">
                  <lookup name="title" type="TerminalPreferencesListItem"/>
                </property>
                <property name="model">
                  <object class="GListStore" id="new_terminal_modes">
                    <property name="item-type">TerminalPreferencesListItem</property>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">In Tab</property>
                        <property name="value">'tab'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">In Window</property>
                        <property name="value">'window'</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="tab_position">
                <property name="title" translatable="yes">New Tab Position</property>
                <property name="expression">
                  <lookup name="title" type="TerminalPreferencesListItem"/>
                </property>
                <property name="model">
                  <object class="GListStore" id="tab_positions">
                    <property name="item-type">TerminalPreferencesListItem</property>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Last</property>
                        <property name="value">'last'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes">Next</property>
                        <property name="value">'next'</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="tab_middle_click">
                <property name="title" translatable="yes">Middle-Click on a Tab</property>
                <property name="expression">
                  <lookup name="title" type="TerminalPreferencesListItem"/>
                </property>
                <property name="model">
                  <object class="GListStore" id="tab_middle_clicks">
                    <property name="item-type">TerminalPreferencesListItem</property>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes" context="tab-middle-click">Does Nothing</property>
                        <property name="value">'nothing'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes" context="tab-middle-click">Closes the Tab</property>
                        <property name="value">'close'</property>
                      </object>
                    </child>
                    <child>
                      <object class="TerminalPreferencesListItem">
                        <property name="title" translatable="yes" context="tab-middle-click">Pastes the Selection</property>
                        <property name="value">'paste'</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="ignore_program_titles">
                <property name="title" translatable="yes">Ignore Titles Set by Programs</property>
                <property name="subtitle" translatable="yes">Show the title set with Set Title, or else the working directory</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="toast_on_copy">
                <property name="title" translatable="yes">Confirm Copying</property>
                <property name="subtitle" translatable="yes">Show a short notice after copying to the clipboard</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="inject_shell_integration">
                <property name="title" translatable="yes">Shell Integration</property>
                <property name="subtitle" translatable="yes">Let bash, zsh and fish report their prompts and commands, for notifications, prompt navigation and copying command output. Applies to new terminals</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="notify_command_finished">
                <property name="title" translatable="yes">Notify When Commands Finish</property>
                <property name="subtitle" translatable="yes">When a long command ends in a terminal you are not looking at. Needs shell integration</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="notify_command_min_duration">
                <property name="title" translatable="yes">Minimum Command Duration</property>
                <property name="subtitle" translatable="yes">In seconds</property>
                <property name="sensitive" bind-source="notify_command_finished" bind-property="active" bind-flags="sync-create"/>
                <property name="numeric">1</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">86400</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="silence_duration">
                <property name="title" translatable="yes">Silence Duration</property>
                <property name="subtitle" translatable="yes">How long a terminal monitored for silence must be quiet, in seconds. Turn monitoring on in the context menu of a terminal</property>
                <property name="numeric">1</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">86400</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="preserve_container">
                <property name="title" translatable="yes">Keep New Tabs in the Same Container</property>
                <property name="subtitle" translatable="yes">New tabs and panes start in the Toolbox or Distrobox container of the terminal they are opened from</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="restore_session">
                <property name="title" translatable="yes">Restore Session</property>
                <property name="subtitle" translatable="yes">Reopen the windows, tabs and panes of the last session, each in its previous folder</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="restore_window_size">
                <property name="title" translatable="yes">Remember Window Size</property>
                <property name="subtitle" translatable="yes">Open new windows with the size of the last used terminal instead of the initial size of the profile</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Quick Terminal</property>
            <property name="description" translatable="yes">A terminal that you show and hide with one key. Use the system-wide shortcut below, or add the command “pano-terminal --quick” in Settings → Keyboard → Custom Shortcuts.</property>
            <child>
              <object class="AdwSwitchRow" id="quick_terminal_global_shortcut">
                <property name="title" translatable="yes">System-Wide Shortcut</property>
                <property name="subtitle" translatable="yes">The desktop asks for the key; F12 is suggested. Pano Terminal then keeps running in the background. Needs GNOME 48 or newer, or KDE Plasma.</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="quick_terminal_extension">
                <property name="visible">false</property>
                <property name="title" translatable="yes">GNOME Shell Extension</property>
                <property name="subtitle" translatable="yes">On Wayland, keeps the quick terminal at the top of the screen, above other windows and on all workspaces</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="quick_terminal_width">
                <property name="title" translatable="yes">Width</property>
                <property name="subtitle" translatable="yes">In percent of the screen</property>
                <property name="numeric">1</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">10</property>
                    <property name="upper">100</property>
                    <property name="step-increment">5</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="quick_terminal_height">
                <property name="title" translatable="yes">Height</property>
                <property name="subtitle" translatable="yes">In percent of the screen</property>
                <property name="numeric">1</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">10</property>
                    <property name="upper">100</property>
                    <property name="step-increment">5</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="quick_terminal_hide_on_unfocus">
                <property name="title" translatable="yes">Hide When Another App Is Used</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="quick_terminal_slide">
                <property name="title" translatable="yes">Slide In From the Top</property>
                <property name="subtitle" translatable="yes">On X11, or with the GNOME Shell extension</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Keyboard Shortcuts</property>
            <child>
              <object class="AdwSwitchRow" id="accelerator_key">
                <property name="title" translatable="yes">Accelerator Key (F10 by default)</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">View and Customize Shortcuts</property>
                <property name="action-name">preferences.view-shortcuts</property>
                <property name="activatable">true</property>
                <child type="suffix">
                  <object class="GtkImage">
                    <property name="icon-name">go-next-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Profiles</property>
            <property name="header-suffix">
              <object class="GtkButton">
                <property name="action-name">profile.import</property>
                <property name="tooltip-text" translatable="yes">Import a profile from a file</property>
                <property name="valign">center</property>
                <style>
                  <class name="flat"/>
                </style>
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">document-open-symbolic</property>
                    <property name="label" translatable="yes">_Import…</property>
                    <property name="use-underline">true</property>
                  </object>
                </property>
              </object>
            </property>
            <child>
              <object class="GtkListBox" id="profiles_list_box">
                <style>
                  <class name="boxed-list"/>
                </style>
                <property name="selection-mode">none</property>
                <child>
                  <object class="AdwPreferencesRow" id="add_profile_row">
                    <property name="action-name">profile.add</property>
                    <child>
                      <object class="GtkImage">
                        <property name="hexpand">true</property>
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="margin-top">16</property>
                        <property name="margin-bottom">16</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Application</property>
            <child>
              <object class="AdwActionRow" id="import_gnome_terminal_row">
                <property name="title" translatable="yes">Import from GNOME Terminal</property>
                <property name="subtitle" translatable="yes">Copy its profiles, keyboard shortcuts and preferences</property>
                <property name="visible">false</property>
                <child type="suffix">
                  <object class="GtkButton">
                    <property name="label" translatable="yes">_Import</property>
                    <property name="use-underline">true</property>
                    <property name="valign">center</property>
                    <property name="action-name">preferences.import-gnome-terminal</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="always_check_default">
                <property name="title" translatable="yes">Ask to Remain Default</property>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="label" translatable="yes">Set as Default Terminal</property>
                <property name="action-name">terminal.set-as-default</property>
                <property name="margin-top">12</property>
                <property name="hexpand">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
