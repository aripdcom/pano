#: src/com.aripd.Pano.gschema.xml:152
msgid "Human-readable name of the profile"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:153
msgid "Human-readable name of the profile."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:157
msgid "Default color of text in the terminal"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:158
msgid ""
"Default color of text in the terminal, as a color specification (can be HTML-"
"style hex digits, or a color name such as “red”)."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:162
msgid "Default color of terminal background"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:163
msgid ""
"Default color of terminal background, as a color specification (can be HTML-"
"style hex digits, or a color name such as “red”)."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:167
msgid "Default color of bold text in the terminal"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:168
msgid ""
"Default color of bold text in the terminal, as a color specification (can be "
"HTML-style hex digits, or a color name such as “red”). This is ignored if "
"bold-color-same-as-fg is true."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:172
msgid "Whether bold text should use the same color as normal text"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:173
msgid ""
"If true, boldface text will be rendered using the same color as normal text."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:178
msgid ""
"Scale factor for the cell height to increase line spacing. (Does not "
"increase the font’s height.)"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:183
msgid ""
"Scale factor for the cell width to increase letter spacing. (Does not "
"increase the font’s width.)"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:187
msgid "Whether to use custom cursor colors"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:188
msgid "If true, use the cursor colors from the profile."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:192
msgid "Cursor background color"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:193
msgid ""
"Custom color of the background of the terminal’s cursor, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”). "
"This is ignored if cursor-colors-set is false."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:197
msgid "Cursor foreground colour"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:198
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"cursor position, as a color specification (can be HTML-style hex digits, or "
"a color name such as “red”). This is ignored if cursor-colors-set is false."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:202
msgid "Whether to use custom highlight colors"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:203
msgid "If true, use the highlight colors from the profile."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:207
msgid "Highlight background color"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:208
msgid ""
"Custom color of the background of the terminal’s highlight, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”). "
"This is ignored if highlight-colors-set is false."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:212
msgid "Highlight foreground colour"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:213
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"highlight position, as a color specification (can be HTML-style hex digits, "
"or a color name such as “red”). This is ignored if highlight-colors-set is "
"false."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:217
msgid "Whether to perform bidirectional text rendering"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:218
msgid "If true, perform bidirectional text rendering (“BiDi”)."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:222
msgid "Whether to perform Arabic shaping"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:223
msgid "If true, shape Arabic text."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:227
msgid "Whether to enable SIXEL images"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:228
msgid "If true, SIXEL sequences are parsed and images are rendered."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:232
msgid "Whether bold is also bright"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:233
msgid ""
"If true, setting bold on the first 8 colors also switches to their bright "
"variants."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:237
msgid "Whether to ring the terminal bell"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:241
msgid "Whether the terminal flashes when the bell rings"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:242
msgid ""
"When the terminal is in a tab in the background, the tab is marked instead."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:246
msgid "List of punctuation characters that are treated as word characters"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:247
msgid ""
"By default, when doing word-wise selection, most punctuation breaks up word "
"boundaries. This list of exceptions will instead be treated as part of the "
"word."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:252
msgid "Default number of columns"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:253
msgid ""
"Number of columns in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:258
msgid "Default number of rows"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:259
msgid ""
"Number of rows in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:263
msgid "When to show the scrollbar"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:267
msgid "Whether to enable kinetic scrolling"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:271
msgid "Number of lines to keep in scrollback"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:272
msgid ""
"Number of scrollback lines to keep around. You can scroll back in the "
"terminal by this number of lines; lines that don’t fit in the scrollback are "
"discarded. If scrollback_unlimited is true, this value is ignored."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:276
msgid "Whether an unlimited number of lines should be kept in scrollback"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:277
msgid ""
"If true, scrollback lines will never be discarded. The scrollback history is "
"stored on disk temporarily, so this may cause the system to run out of disk "
"space if there is a lot of output to the terminal."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:281
msgid "Whether to scroll to the bottom when text is inserted"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:282
msgid ""
"If true, the terminal will scroll to the bottom when text is inserted by "
"paste."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:286
msgid "Whether to scroll to the bottom when a key is pressed"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:287
msgid "If true, pressing a key jumps the scrollbar to the bottom."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:291
msgid "Whether to scroll to the bottom when there’s new output"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:292
msgid ""
"If true, whenever there’s new output the terminal will scroll to the bottom."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:296
msgid "What to do with the terminal when the child command exits"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:297
msgid ""
"Possible values are “close” to close the terminal, “restart” to restart the "
"command, and “hold” to keep the terminal open with no command running inside."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:301
msgid "Whether to launch the command in the terminal as a login shell"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:302
msgid ""
"If true, the command inside the terminal will be launched as a login shell "
"(argv[0] will have a hyphen in front of it)."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:306
msgid "Whether to preserve the working directory when opening a new terminal"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:307
msgid ""
"Controls when opening a new terminal from a previous one carries over the "
"working directory of the opening terminal to the new one."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:313
msgid "Whether to run a custom command instead of the shell"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:314
msgid ""
"If true, the value of the custom_command setting will be used in place of "
"running a shell."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:318
msgid "Whether to blink the cursor"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:319
msgid ""
"The possible values are “system” to use the global cursor blinking settings, "
"or “on” or “off” to set the mode explicitly."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:323
msgid "The cursor appearance"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:327
msgid ""
"Possible values are “always” or “never” allow blinking text, or only when "
"the terminal is “focused” or “unfocused”."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:331
msgid "Custom command to use instead of the shell"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:332
msgid "Run this command in place of the shell, if use_custom_command is true."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:336
msgid "The color scheme, or empty for the colors set in this profile"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:337
msgid ""
"The name of a .palette file, without the suffix. Its colors replace the "
"foreground, background and palette of the profile, and follow the light or "
"dark style of the system if the scheme has both."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:342
msgid "Opacity of the terminal background"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:343
msgid ""
"1.0 is opaque. With lower values the desktop shows through the background of "
"the terminal; the text stays opaque."
msgstr ""

