msgid "What a middle click on a tab does"
msgstr ""

#: src/com.aripd.Pano.gschema.xml:883
msgid ""
"“close” closes the tab; “paste” switches to the tab and pastes the primary "
"selection into it."
msgstr ""

#: src/com.aripd.Pano.gschema.xml:888
msgid "Whether windows should have rounded corners"
msgstr ""

