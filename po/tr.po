msgstr "Son kapatılan sekmeyi yeniden açmak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:439
msgid "Keyboard shortcut to close a window"
msgstr "Pencereyi kapatmak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:443
msgid "Keyboard shortcut to copy text"
msgstr "Metni kopyalamak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:447
msgid "Keyboard shortcut to copy text as HTML"
msgstr "Metni HTML olarak kopyalamak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:451
msgid "Keyboard shortcut to paste text"
msgstr "Metin yapıştırmak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:455
msgid "Keyboard shortcut to select all text"
msgstr "Tüm metni seçmek için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:459
msgid "Keyboard shortcut to open the Preferences dialog"
msgstr "Tercihler iletişim penceresini açmak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:463
msgid "Keyboard shortcut to toggle full screen mode"
msgstr "Tam ekran kipi için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:467
msgid "Keyboard shortcut to toggle the read-only state"
msgstr "Salt-okunur durumunu değiştirmek için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:471
msgid ""
"Keyboard shortcut to label URLs, paths and more on the screen, to copy them "
"by typing the label"
msgstr ""
"Ekrandaki URL’leri, yolları ve daha fazlasını etiketlemek, etiketi yazarak "
"kopyalamak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:475
msgid "Keyboard shortcut to open the command palette"
msgstr "Komut paletini açmak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:479
msgid ""
"Keyboard shortcut to set a title for the terminal that programs cannot change"
msgstr ""
"Uçbirime programların değiştiremeyeceği bir başlık vermek için kullanılan "
"klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:483
msgid "Keyboard shortcut to reset the terminal"
msgstr "Uçbirimi sıfırlamak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:487
msgid "Keyboard shortcut to reset and clear the terminal"
msgstr "Ekranı sıfırlamak ve silmek için klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:491
msgid "Keyboard shortcut to open the search dialog"
msgstr "Arama iletişim penceresini açmak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:495
msgid "Keyboard shortcut to find the next occurrence of the search term"
msgstr "Arama teriminin bulunduğu bir sonraki yeri bulmak için klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:499
msgid "Keyboard shortcut to find the previous occurrence of the search term"
msgstr "Arama teriminin bulunduğu bir önceki yeri bulmak için klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:503
msgid "Keyboard shortcut to clear the find highlighting"
msgstr "Bulma vurgulamasını temizleyen klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:507
msgid "Keyboard shortcut to switch to the previous tab"
msgstr "Önceki sekmeye geçmek için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:511
msgid "Keyboard shortcut to switch to the next tab"
msgstr "Sonraki sekmeye geçmek için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:515
msgid "Keyboard shortcut to move the current tab to the left"
msgstr "Geçerli sekmeyi sola taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:519
msgid "Keyboard shortcut to move the current tab to the right"
msgstr "Geçerli sekmeyi sağa taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:523
msgid "Keyboard shortcut to move the current tab to the start"
msgstr "Geçerli sekmeyi başa taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:527
msgid "Keyboard shortcut to move the current tab to the end"
msgstr "Geçerli sekmeyi sona taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:531
msgid "Keyboard shortcut to detach current tab"
msgstr "Geçerli sekmeyi ayırmak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:535
