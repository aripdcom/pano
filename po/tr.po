msgstr ""
"Sekmenin bölmelerini aynı boyuta getirmek için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:579
msgid "Keyboard shortcut to move the active pane to a new tab"
msgstr "Etkin bölmeyi yeni bir sekmeye taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:583
msgid "Keyboard shortcut to move the focus to the pane on the left"
msgstr "Odağı soldaki bölmeye taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:587
msgid "Keyboard shortcut to move the focus to the pane on the right"
msgstr "Odağı sağdaki bölmeye taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:591
msgid "Keyboard shortcut to move the focus to the pane above"
msgstr "Odağı üstteki bölmeye taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:595
msgid "Keyboard shortcut to move the focus to the pane below"
msgstr "Odağı alttaki bölmeye taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:599
msgid "Keyboard shortcut to move the divider of the active pane to the left"
msgstr ""
"Etkin bölmenin ayırıcısını sola taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:603
msgid "Keyboard shortcut to move the divider of the active pane to the right"
msgstr ""
"Etkin bölmenin ayırıcısını sağa taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:607
msgid "Keyboard shortcut to move the divider of the active pane up"
msgstr ""
"Etkin bölmenin ayırıcısını yukarı taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:611
msgid "Keyboard shortcut to move the divider of the active pane down"
msgstr ""
"Etkin bölmenin ayırıcısını aşağı taşımak için kullanılan klavye kısayolu"

#: src/com.aripd.Pano.gschema.xml:615
msgid "Keyboard shortcut to swap the active pane with the pane on the left"
msgstr ""
"Etkin bölmeyi soldaki bölmeyle yer değiştirmek için kullanılan klavye "
"kısayolu"

#: src/com.aripd.Pano.gschema.xml:619
msgid "Keyboard shortcut to swap the active pane with the pane on the right"
msgstr ""
"Etkin bölmeyi sağdaki bölmeyle yer değiştirmek için kullanılan klavye "
"kısayolu"

#: src/com.aripd.Pano.gschema.xml:623
msgid "Keyboard shortcut to swap the active pane with the pane above"
msgstr ""
"Etkin bölmeyi üstteki bölmeyle yer değiştirmek için kullanılan klavye "
"kısayolu"

#: src/com.aripd.Pano.gschema.xml:627
msgid "Keyboard shortcut to swap the active pane with the pane below"
msgstr ""
"Etkin bölmeyi alttaki bölmeyle yer değiştirmek için kullanılan klavye "
"kısayolu"

#: src/com.aripd.Pano.gschema.xml:631
msgid "Keyboard shortcut to show the tabs overview"
msgstr "Sekmelere genel bakışı göstermek için kullanılan klavye kısayolu"

