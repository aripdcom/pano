#: data/com.aripd.Pano.Nautilus.metainfo.xml.in:39
#, fuzzy
#| msgid ""
#| "Open Terminal is a plugin for the Files application that adds a menu item "
#| "to the context menu to open a terminal in the currently browsed directory."
msgid ""
"Open in Pano Terminal is a plugin for the Files application that adds a menu "
"item to the context menu to open Pano Terminal in the currently browsed "
"directory."
msgstr ""
"Открыть терминал — модуль для приложения Nautilus, который добавляет в "
"строку в контекстном меню для открытия терминала в текущей просматриваемой "
"папке."

