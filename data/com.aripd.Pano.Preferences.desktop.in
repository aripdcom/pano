[Desktop Entry]
Categories=GNOME;GTK;System;TerminalEmulator;
Comment=Configure the command line
DBusActivatable=false
Exec=pano-terminal --preferences
Icon=com.aripd.Pano.Preferences
Keywords=shell;prompt;command;commandline;cmd;
Name=Pano Terminal Preferences
NoDisplay=true
SingleMainWindow=true
StartupNotify=true
StartupWMClass=Pano-preferences
TryExec=pano-terminal
Type=Application
